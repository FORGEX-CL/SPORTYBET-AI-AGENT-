# Authentication
# Local fallback only. Production should use the cloud registry below.
SPORTYBET_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_USERS_JSON=[]

# Supabase cloud authentication
# Keep the secret key server-side only. Never expose it to browser code or GitHub.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# One-time first-admin bootstrap. Set a random 32+ character secret only in deployment environment, never in GitHub.
ADMIN_BOOTSTRAP_SECRET=replace-with-a-random-bootstrap-secret-at-least-32-characters

# Multimodal AI chat through Vercel AI Gateway (server-side only)
AI_GATEWAY_API_KEY=replace-with-your-vercel-ai-gateway-key
