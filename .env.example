# Authentication
# Generate a password hash with: npm run auth:hash
# Keep both values in the deployment environment only. Never commit real credentials.
SPORTYBET_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_USERS_JSON=[{"username":"admin-user","role":"admin","passwordHash":"scrypt$16384$8$1$replace-with-generated-salt$replace-with-generated-digest"},{"username":"approved-user","role":"user","passwordHash":"scrypt$16384$8$1$replace-with-generated-salt$replace-with-generated-digest"}]
